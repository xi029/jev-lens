# The default demo is an explicitly labelled lexical simulation, not an AI model.
JEVLENS_PROVIDER=demo
JEVLENS_OLLAMA_URL=http://127.0.0.1:11434
JEVLENS_OLLAMA_MODEL=qwen3.5:4b
# A self-hosted Laya server: pip install "laya[serve]"; laya-serve
JEVLENS_LAYA_URL=http://127.0.0.1:8123
JEVLENS_LAYA_MODEL=english
JEVLENS_LAYA_API_KEY=
JEVLENS_JEV_URL=https://api.typesafe.ai
JEVLENS_JEV_MODEL=jev-latest
JEVLENS_JEV_API_KEY=
JEVLENS_DATA_DIR=data
JEVLENS_TIMEOUT_SECONDS=120
# This is a character budget, NOT a tokenizer guarantee. Inspect the trace and
# configure your Laya server's max_len for the checkpoint you actually use.
JEVLENS_LAYA_STATE_CHARS=1600
# Average four cyclic option orders to reduce one documented source of label bias.
JEVLENS_LAYA_BALANCE_OPTIONS=true
